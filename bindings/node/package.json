{
  "name": "@turbo-napi/node",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/napi-rs/package-template-pnpm.git"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "fix": "cargo fmt",
    "napi": "napi",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.6",
    "@oxc-node/core": "^0.1.0",
    "@packages/typescript-config": "workspace:*"
  },
  "engines": {
    "node": ">= 22.14.0 < 23 || >= 23.6.0"
  },
  "napi": {
    "binaryName": "turbo_napi",
    "targets": [
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu"
    ]
  }
}
