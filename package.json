{
  "name": "turbo-napi",
  "private": true,
  "workspaces": [
    "crates/*",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:api": "turbo run build --filter @packages/api",
    "build:bindings": "turbo run build --filter @bindings/node --filter @bindings/web",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fix": "ultracite fix && turbo run fix",
    "test": "turbo run test",
    "test:rust": "cargo test -p turbo-engine"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "lefthook": "^2.1.12",
    "turbo": "^2.10.12",
    "ultracite": "7.11.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
