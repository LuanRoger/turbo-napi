{
  "name": "@turbo-napi/sdk",
  "version": "1.0.0",
  "private": false,
  "description": "Public JavaScript SDK for the native and WebAssembly bindings",
  "license": "MIT",
  "author": "Luan Roger <luanroger.dev@gmail.com> (https://github.com/LuanRoger)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsdown -c tsdown.config.ts",
    "check-types": "tsc --noEmit",
    "dev": "tsdown --watch ./src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@turbo-napi/node": "workspace:*",
    "@packages/typescript-config": "workspace:*",
    "tsdown": "^0.22.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
